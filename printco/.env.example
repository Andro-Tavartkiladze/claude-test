# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Gateway: 'mock' (no credentials, fully working simulator) or 'bog' (live).
PAYMENT_GATEWAY=mock

# Public base URL of the site (used to build callback/redirect URLs).
APP_BASE_URL=http://localhost:8080

# SQLite database file.
DB_PATH=./data/payments.sqlite

# Dunning: failed automatic charges before a subscription becomes past_due.
DUNNING_MAX_RETRIES=3

# Secret used to authenticate the mock gateway callback (mock mode only).
MOCK_CALLBACK_SECRET=change-me-in-dev

# Admin panel (HTTP Basic) credentials.
ADMIN_USER=admin
ADMIN_PASS=change-me

# ---- Bank of Georgia (iPay) — fill these when you receive merchant access --
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# RSA public key (PEM) BOG uses to sign callbacks, for signature verification.
BOG_PUBLIC_KEY=
# Defaults below match BOG's public endpoints; override if your contract differs.
BOG_OAUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
BOG_API_BASE=https://api.bog.ge/payments/v1
